# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=local

# Database Configuration (Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=root
DB_PASSWORD=

# Database Configuration (Production)
PROD_DB_HOST=your_production_host
PROD_DB_PORT=3306
PROD_DB_NAME=your_production_database
PROD_DB_USER=your_production_user
PROD_DB_PASS=your_production_password

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ISSUER=public-safety-campaign-system
JWT_AUDIENCE=public-safety-campaign-system
JWT_EXPIRY_SECONDS=86400

# SMTP Configuration for OTP Emails
# For Gmail: Enable "Less secure app access" or use App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Alertara QC

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-secret
